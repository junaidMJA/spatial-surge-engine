# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL / PostGIS (used by docker-compose to bootstrap the db container)
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spatial_engine

# ---------------------------------------------------------------------------
# Node application database connection (used locally and by the API container)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=spatial_engine

# Optional: a full connection string overrides the individual DB_* fields above.
# Inside docker-compose the API service is given a container-internal URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spatial_engine

# Connection pool sizing
DB_POOL_MAX=10

# Surge pricing demand-sampling window (minutes)
SURGE_WINDOW_MINUTES=15